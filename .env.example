# Neon: dashboard -> Connect -> copy the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Shop admin account, created by:  npm run db:admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Shown to customers after checkout (pay-by-check instructions)
CHECK_PAYABLE_TO=JKA/AF
CHECK_MAIL_TO="JKA/AF
Street address
City, ST 00000"

# Email (SMTP): order invoices, account activation. Skipped (and logged) until SMTP_HOST and EMAIL_FROM are set.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JKA/AF <orders@yourdomain.com>"
# Optional: customer replies go to EMAIL_REPLY_TO; ORDER_NOTIFY_EMAIL gets a BCC copy of every invoice
EMAIL_REPLY_TO=
ORDER_NOTIFY_EMAIL=
# Optional: used for the sign-in link in emails
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: new Dojo Membership applications (PDF attached) are emailed here; falls back to ORDER_NOTIFY_EMAIL
APPLICATION_NOTIFY_EMAIL=

# ───────── Online payments (optional; leave blank to keep "pay by check" only) ─────────
# Each one switches on by itself when its keys are filled in. See README.md ("Turning on card and PayPal payments").
# Stripe (card): Developers -> API keys, and Developers -> Webhooks -> your endpoint's signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal: developer.paypal.com -> Apps & Credentials. PAYPAL_ENV is "sandbox" for testing or "live" for real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Addresses the site must never email (comma separated). Default: jkaafusa@gmail.com while the website is not live.
# When you go live, set it to "none" (or list only the addresses to block).
EMAIL_BLOCKLIST=jkaafusa@gmail.com
