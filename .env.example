# Neon: dashboard -> Connect -> copy the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Shop admin account, created by:  npm run db:admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Shown to customers after checkout (pay-by-check instructions)
CHECK_PAYABLE_TO=JKA/AF
CHECK_MAIL_TO="JKA/AF
Street address
City, ST 00000"

# Order emails (invoice sent to the customer after checkout), via https://resend.com
# Skipped (and logged) until RESEND_API_KEY and EMAIL_FROM are set. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="JKA/AF <orders@yourdomain.com>"
# Optional: customer replies go to EMAIL_REPLY_TO; ORDER_NOTIFY_EMAIL gets a BCC copy of every invoice
EMAIL_REPLY_TO=
ORDER_NOTIFY_EMAIL=
