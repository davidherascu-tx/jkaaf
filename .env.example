# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The "service_role" (secret) key. Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Shop admin account, created by:  npm run db:admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Shown to customers after checkout (pay-by-check instructions)
CHECK_PAYABLE_TO=JKA/AF
CHECK_MAIL_TO="JKA/AF
Street address
City, ST 00000"
