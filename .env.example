# Shop admin account, created automatically the first time the shop database is created.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Shown to customers after checkout (pay-by-check instructions)
CHECK_PAYABLE_TO=JKA/AF
CHECK_MAIL_TO="JKA/AF
Street address
City, ST 00000"

# Optional: where the SQLite file lives (default ./data/shop.db). Needs a persistent disk.
# SHOP_DB_PATH=
