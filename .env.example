# Neon: dashboard -> Connect -> copy the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Shop admin account, created by:  npm run db:admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Shown to customers after checkout (pay-by-check instructions)
CHECK_PAYABLE_TO=JKA/AF
CHECK_MAIL_TO="JKA/AF
Street address
City, ST 00000"
